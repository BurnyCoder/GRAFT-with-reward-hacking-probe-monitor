# Global context: all generated experiment data and caches stay in this checkout.
# Local context: python-dotenv loads these defaults without overriding shell values.
GRAFT_ARTIFACTS=artifacts/qwen_probe
HF_HOME=.cache/huggingface
HF_HUB_CACHE=.cache/huggingface/hub
HF_DATASETS_CACHE=.cache/datasets
TORCH_HOME=.cache/torch
TRITON_CACHE_DIR=.cache/triton
XDG_CACHE_HOME=.cache
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1
GRAFT_ATTENTION=sdpa
GRAFT_SERVER_PORT=8765
# Set HF_TOKEN privately for publication; never commit its value.
# HF_TOKEN=
